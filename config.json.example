{
  "data_dir": "./data/",
  "predictions_dir": "./predictions/",
  "model_name": "var-cnn",
  "mixture": [
    ["dir"],
    ["time"],
    ["length"],
    ["metadata"],
    ["dir", "time", "metadata"],
    ["dir", "length", "metadata"],
    ["time", "length", "metadata"],
    ["dir", "time", "length", "metadata"]
  ],
  "batch_size": 128,
  "var_cnn_max_epochs": 100,
  "df_epochs": 50,
  "num_mon_sites": 50,
  "num_mon_inst_train": 10,
  "num_mon_inst_test": 5,
  "num_unmon_sites_train": 10,
  "num_unmon_sites_test": 10,
  "seq_length": 5000,
  "inter_time": true,
  "scale_metadata": true,
  "dir_dilations": true,
  "time_dilations": true,
  "var_cnn_base_patience": 5
}
